# flowforge configuration (copy to .env)

# Event store / control plane
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5432/flowforge

# Work queues, distributed locks, timer signalling
REDIS_URL=redis://localhost:6379/0

# LLM steps
OPENAI_API_KEY=

# Cost control. The budget is a rolling 24h cap per tenant; a run that would
# exceed it is cancelled (and compensated). Unset = account, but do not enforce.
TENANT_BUDGET_USD_PER_DAY=
# Sustained outbound calls per second, per provider. Unset = unlimited.
LLM_RATE_LIMIT_PER_SECOND=

# Tracing. Set the endpoint (an OTLP/HTTP collector, e.g. http://localhost:4318)
# to turn it on: one span tree per run, across workers and restarts. Unset = off,
# and the tracer costs nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=flowforge
